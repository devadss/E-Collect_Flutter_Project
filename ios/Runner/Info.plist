<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Collection Qr</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.collection.qr</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Collection Qr</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>

    <!-- Required for Firebase and Local Network Debugging -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>This app needs local network access for Flutter debugging and Firebase services.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_dartobservatory._tcp</string>
    </array>

    <!-- Required for Notifications -->
    <key>NSUserNotificationAlertUsageDescription</key>
    <string>This app needs permission to send you notifications.</string>

    <!-- Optional: Required if using biometric auth -->
    <key>NSFaceIDUsageDescription</key>
    <string>This app uses Face ID or Touch ID to authenticate the user.</string>

    <!-- URL Schemes for deep linking, phone, SMS, etc. -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>tel</string>
        <string>sms</string>
        <string>mailto</string>
    </array>

    <!-- Allow remote notifications in background -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
     <key>FirebaseAppDelegateProxyEnabled</key>
        <false/>

    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <!-- Orientation support -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Flutter-specific settings -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
</dict>
</plist>
